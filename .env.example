# Copy to .env and adjust. Never commit the real .env file.

# --- Server ---
PORT=4000
# Set to "production" when deployed.
NODE_ENV=development
# info | debug | warn | error | silent
LOG_LEVEL=info
# Only needed when the client is served from a different origin (e.g. Vercel). Comma-separated.
CORS_ORIGIN=

# --- Crawl safety limits (US-04 AC-10) ---
SCAN_MAX_PAGES=50
SCAN_MAX_DEPTH=5
SCAN_PAGE_TIMEOUT_MS=15000
SCAN_CONCURRENCY=3
# Hard cap on a whole website scan.
SCAN_MAX_DURATION_MS=600000

# --- Service protection ---
# Timeout for the reachability check that runs before a scan starts.
VALIDATION_TIMEOUT_MS=10000
# Scans that may run at the same time on this server.
MAX_ACTIVE_SCANS=2
# How long finished scans stay in memory (no database in Sprint 1).
SCAN_TTL_MINUTES=60
# POST /api/scans requests allowed per IP per minute.
RATE_LIMIT_PER_MINUTE=10

# --- Browser ---
# Optional path to a Chromium binary. Leave empty to use the one installed by `npx playwright install chromium`.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# --- Testing only ---
# Lets the scanner reach localhost fixture sites in automated tests.
# NEVER enable in production – it disables SSRF protection. Ignored when NODE_ENV=production.
ALLOW_PRIVATE_NETWORK_TARGETS=false

# --- Client (Vite) ---
# Base URL of the API when the client is deployed separately. Leave empty for local dev (Vite proxies /api).
VITE_API_URL=
